# agent-bom v0.104.0 terminal demo
# Real CLI output, presented as three labeled excerpts by the owning renderer.
Output docs/images/demo-latest.gif
Set Shell "bash"
Set FontSize 18
Set Width 1360
Set Height 780
Set Theme "Dracula"
Set Padding 24
Set TypingSpeed 0ms
Set PlaybackSpeed 1.0
Hide
Type "bash scripts/render_demo.sh"
Enter
Sleep 3s
Show
Sleep 24s
