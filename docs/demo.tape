# agent-bom v0.103.1 terminal demo
# Shows: posture-led scan → findings queue → fix-first

Output docs/images/demo-latest.gif

Set Shell "bash"
Set FontSize 16
Set Width 1100
Set Height 780
Set Theme "Dracula"
Set Padding 20
Set TypingSpeed 0ms
Set PlaybackSpeed 1.0

# The first visible frame is the same public command shown in the README.
# Keep the recording self-contained and do not expose repository-only scripts.
Type "agent-bom scan --demo --offline -f console"
Enter
Sleep 12s
