{
  "additionalProperties": false,
  "description": "Signed assignment for one external producer in an immutable cohort.",
  "properties": {
    "child_job_id": {
      "maxLength": 36,
      "minLength": 36,
      "title": "Child Job Id",
      "type": "string"
    },
    "cohort_manifest_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Cohort Manifest Hash",
      "type": "string"
    },
    "correlation_cohort_id": {
      "maxLength": 36,
      "minLength": 36,
      "title": "Correlation Cohort Id",
      "type": "string"
    },
    "expires_at": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Expires At",
      "type": "string"
    },
    "issued_at": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Issued At",
      "type": "string"
    },
    "max_age_hours": {
      "maximum": 8760,
      "minimum": 1,
      "title": "Max Age Hours",
      "type": "integer"
    },
    "parent_job_id": {
      "maxLength": 36,
      "minLength": 36,
      "title": "Parent Job Id",
      "type": "string"
    },
    "schema_version": {
      "const": "agent-bom.correlation-cohort-child/v1",
      "default": "agent-bom.correlation-cohort-child/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "signature": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Signature",
      "type": "string"
    },
    "source_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    },
    "source_kind": {
      "enum": [
        "ingest.result_push",
        "runtime.proxy",
        "runtime.gateway"
      ],
      "title": "Source Kind",
      "type": "string"
    },
    "tenant_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "correlation_cohort_id",
    "cohort_manifest_hash",
    "parent_job_id",
    "child_job_id",
    "source_id",
    "source_kind",
    "max_age_hours",
    "issued_at",
    "expires_at",
    "signature"
  ],
  "title": "CorrelationCohortChildReceipt",
  "type": "object"
}
