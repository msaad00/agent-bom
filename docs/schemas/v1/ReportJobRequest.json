{
  "$defs": {
    "ReportFormat": {
      "description": "Supported async report artifact formats.",
      "enum": [
        "ndjson"
      ],
      "title": "ReportFormat",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Request body for ``POST /v1/reports``.",
  "properties": {
    "account": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Account"
    },
    "domain": {
      "anyOf": [
        {
          "maxLength": 32,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Domain"
    },
    "environment": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Environment"
    },
    "finding_class": {
      "anyOf": [
        {
          "enum": [
            "vulnerability",
            "misconfiguration",
            "secret",
            "pii",
            "identity",
            "unclassified"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finding Class"
    },
    "format": {
      "$ref": "#/$defs/ReportFormat",
      "default": "ndjson"
    },
    "owner": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Owner"
    },
    "provider": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider"
    },
    "q": {
      "anyOf": [
        {
          "maxLength": 256,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Q"
    },
    "scan_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scan Id"
    },
    "severity": {
      "anyOf": [
        {
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info",
            "informational",
            "none",
            "unknown"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Severity"
    },
    "sla": {
      "anyOf": [
        {
          "enum": [
            "overdue",
            "due",
            "unassigned"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sla"
    },
    "sort": {
      "default": "effective_reach",
      "enum": [
        "effective_reach",
        "cvss",
        "severity",
        "ordinal"
      ],
      "title": "Sort",
      "type": "string"
    },
    "status": {
      "default": "open",
      "enum": [
        "open",
        "resolved",
        "all"
      ],
      "title": "Status",
      "type": "string"
    },
    "window_days": {
      "anyOf": [
        {
          "maximum": 3650,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Window Days"
    }
  },
  "title": "ReportJobRequest",
  "type": "object"
}
