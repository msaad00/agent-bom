{
  "$defs": {
    "CorrelationCohortChildReceipt": {
      "additionalProperties": false,
      "description": "Signed assignment for one external producer in an immutable cohort.",
      "properties": {
        "child_job_id": {
          "maxLength": 36,
          "minLength": 36,
          "title": "Child Job Id",
          "type": "string"
        },
        "cohort_manifest_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Cohort Manifest Hash",
          "type": "string"
        },
        "correlation_cohort_id": {
          "maxLength": 36,
          "minLength": 36,
          "title": "Correlation Cohort Id",
          "type": "string"
        },
        "expires_at": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Expires At",
          "type": "string"
        },
        "issued_at": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Issued At",
          "type": "string"
        },
        "max_age_hours": {
          "maximum": 8760,
          "minimum": 1,
          "title": "Max Age Hours",
          "type": "integer"
        },
        "parent_job_id": {
          "maxLength": 36,
          "minLength": 36,
          "title": "Parent Job Id",
          "type": "string"
        },
        "schema_version": {
          "const": "agent-bom.correlation-cohort-child/v1",
          "default": "agent-bom.correlation-cohort-child/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "signature": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Signature",
          "type": "string"
        },
        "source_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_kind": {
          "enum": [
            "ingest.result_push",
            "runtime.proxy",
            "runtime.gateway"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "tenant_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "correlation_cohort_id",
        "cohort_manifest_hash",
        "parent_job_id",
        "child_job_id",
        "source_id",
        "source_kind",
        "max_age_hours",
        "issued_at",
        "expires_at",
        "signature"
      ],
      "title": "CorrelationCohortChildReceipt",
      "type": "object"
    },
    "RuntimeEvidenceSignalIn": {
      "additionalProperties": false,
      "description": "One raw CWPP runtime/EDR signal in an ingest batch.\n\nTenant/provider/account are NOT taken from the client here \u2014 they come from\nthe authenticated source (confused-deputy guard in ``build_runtime_signal``).\n``provider``/``account_id`` may be echoed for the source's own bookkeeping but\na mismatch against the authenticated source is rejected.",
      "properties": {
        "account_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account Id"
        },
        "dedup_key": {
          "title": "Dedup Key",
          "type": "string"
        },
        "evidence": {
          "additionalProperties": true,
          "title": "Evidence",
          "type": "object"
        },
        "observed_at": {
          "description": "Source observation time in ISO-8601 form; required and normalized to fixed-width UTC on ingest.",
          "title": "Observed At",
          "type": "string"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "severity": {
          "default": "unknown",
          "title": "Severity",
          "type": "string"
        },
        "signal_type": {
          "title": "Signal Type",
          "type": "string"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        },
        "workload_ref": {
          "title": "Workload Ref",
          "type": "string"
        }
      },
      "required": [
        "workload_ref",
        "signal_type",
        "dedup_key",
        "observed_at"
      ],
      "title": "RuntimeEvidenceSignalIn",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Authenticated, tenant-scoped CWPP runtime workload-evidence ingest batch.",
  "properties": {
    "correlation_child_receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/CorrelationCohortChildReceipt"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "correlation_cohort_id": {
      "anyOf": [
        {
          "maxLength": 36,
          "minLength": 36,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlation Cohort Id"
    },
    "secret": {
      "title": "Secret",
      "type": "string"
    },
    "signals": {
      "items": {
        "$ref": "#/$defs/RuntimeEvidenceSignalIn"
      },
      "maxItems": 1000,
      "title": "Signals",
      "type": "array"
    },
    "source_id": {
      "title": "Source Id",
      "type": "string"
    }
  },
  "required": [
    "source_id",
    "secret"
  ],
  "title": "RuntimeEvidenceIngestRequest",
  "type": "object"
}
