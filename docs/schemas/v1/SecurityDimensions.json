            "type": "string"
          },
          "maxItems": 20,
          "title": "Reason Codes",
          "type": "array"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 10.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "status": {
          "$ref": "#/$defs/EvidenceStatus"
        }
      },
      "required": [
        "status"
      ],
      "title": "RiskDimension",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Public contract keeping security dimensions and evidence independent.",
  "properties": {
    "completeness": {
      "$ref": "#/$defs/EvidenceCompletenessLedger"
    },
    "evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvidenceProvenance"
      },
      "maxItems": 500,
      "title": "Evidence",
      "type": "array"
    },
    "exploitability": {
      "$ref": "#/$defs/ExploitabilityDimension"
    },
    "exposure": {
      "$ref": "#/$defs/ExposureAssessment"
    },
    "impact": {
      "$ref": "#/$defs/ImpactDimension"
    },
    "likelihood": {
      "$ref": "#/$defs/LikelihoodDimension"
    },
    "reachability": {
      "$ref": "#/$defs/ReachabilityDimension"
    },
    "risk": {
      "$ref": "#/$defs/RiskDimension"
    },
    "schema_version": {
      "const": "security-dimensions.v1",
      "default": "security-dimensions.v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "exposure",
    "reachability",
    "exploitability",
    "likelihood",
    "impact",
    "risk",
    "completeness"
  ],
  "title": "SecurityDimensions",
  "type": "object"
}
