            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Affected Asset Count"
        },
        "business_criticality": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Business Criticality"
        },
        "data_sensitivity": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Sensitivity"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[^\\s]+$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Evidence Refs",
          "type": "array"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_.:-]{0,63}$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Reason Codes",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/EvidenceStatus"
        },
        "technical_categories": {
          "default": [],
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Technical Categories",
          "type": "array"
        }
      },
      "required": [
        "status"
      ],
      "title": "ImpactDimension",
      "type": "object"
    },
    "LikelihoodDimension": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "As Of"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[^\\s]+$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Evidence Refs",
          "type": "array"
        },
        "known_exploited": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Known Exploited"
        },
        "method": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "model_version": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Version"
        },
        "probability": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Probability"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_.:-]{0,63}$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Reason Codes",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/EvidenceStatus"
        }
      },
      "required": [
        "status"
      ],
      "title": "LikelihoodDimension",
      "type": "object"
    },
    "ReachabilityDimension": {
      "additionalProperties": false,
      "properties": {
        "evidence_refs": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[^\\s]+$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Evidence Refs",
          "type": "array"
        },
        "min_hops": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
