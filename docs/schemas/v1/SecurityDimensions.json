    "ReachabilityVerdict": {
      "enum": [
        "confirmed",
        "likely",
        "unknown",
        "unlikely"
      ],
      "title": "ReachabilityVerdict",
      "type": "string"
    },
    "RiskDimension": {
      "additionalProperties": false,
      "properties": {
        "evidence_refs": {
          "default": [],
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[^\\s]+$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Evidence Refs",
          "type": "array"
        },
        "factor_dimensions": {
          "default": [],
          "items": {
            "enum": [
              "exposure",
              "reachability",
              "exploitability",
              "likelihood",
              "impact"
            ],
            "type": "string"
          },
          "maxItems": 5,
          "title": "Factor Dimensions",
          "type": "array"
        },
        "method": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
