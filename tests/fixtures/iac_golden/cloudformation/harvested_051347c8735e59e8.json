{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Resources": {
    "AdminPolicy": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "admin",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "*",
              "Resource": "arn:aws:s3:::bucket"
            }
          ]
        }
      }
    }
  }
}