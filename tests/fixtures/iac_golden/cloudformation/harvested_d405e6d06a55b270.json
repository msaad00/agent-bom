{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Resources": {
    "Bucket1": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "BucketName": "bucket1"
      }
    },
    "Bucket2": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "BucketName": "bucket2",
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        }
      }
    }
  }
}