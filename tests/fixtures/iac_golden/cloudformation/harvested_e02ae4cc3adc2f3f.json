{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Resources": {
    "ScopedPolicy": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "scoped",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "s3:GetObject",
              "Resource": "arn:aws:s3:::my-bucket/*"
            }
          ]
        }
      }
    }
  }
}