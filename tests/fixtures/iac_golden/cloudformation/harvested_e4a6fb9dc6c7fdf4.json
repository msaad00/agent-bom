{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Resources": {
    "BroadPolicy": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "broad",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "s3:GetObject",
              "Resource": "*"
            }
          ]
        }
      }
    }
  }
}