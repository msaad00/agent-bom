    },
    "results": [],
    "tool": {
     "driver": {
      "informationUri": "https://github.com/msaad00/agent-bom",
      "name": "agent-bom",
      "rules": [],
      "version": "<VERSION>"
     }
    }
   }
  ],
  "version": "2.1.0"
 },
