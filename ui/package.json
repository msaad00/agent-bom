{
  "name": "ui",
  "version": "0.102.0",
  "private": true,
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": "^22.22.2 || >=24.15.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "bundle:check": "node scripts/assert-install-matches-lockfile.mjs && node scripts/check-bundle-budget.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "lock:normalize": "npm install --package-lock-only --ignore-scripts",
    "test:e2e": "node scripts/assert-install-matches-lockfile.mjs && node scripts/assert-build-is-current.mjs && playwright test",
    "verify:toolchain": "node scripts/verify-toolchain.mjs",
    "headers:sync": "node scripts/sync-vercel-headers.mjs",
    "headers:check": "node scripts/sync-vercel-headers.mjs --check",
    "capture:product-proof": "node scripts/capture-product-proof.mjs",
    "codegen:graph-schema": "node scripts/codegen-graph-schema.mjs",
    "codegen:graph-schema:check": "node scripts/codegen-graph-schema.mjs --check",
    "test": "vitest",
    "test:run": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "install:verify": "node scripts/assert-install-matches-lockfile.mjs",
    "build:verify": "node scripts/assert-build-is-current.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@tanstack/react-table": "9.1.2",
    "@tanstack/react-virtual": "^3.14.9",
    "@xyflow/react": "^12.11.3",
    "graphology": "^0.26.0",
    "lucide-react": "^1.30.0",
    "next": "^16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "sigma": "^3.0.3"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "postcss": "8.5.23",
    "minimatch@3.1.5": "10.2.5",
    "sharp": "^0.35.0",
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.17"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.3.1",
    "@playwright/test": "^1.62.1",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/dagre": "^0.7.54",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.3.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^30.0.1",
    "lightningcss": "1.33.0",
    "storybook": "^10.5.8",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
